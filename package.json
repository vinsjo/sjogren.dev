{
  "name": "sjogren.dev",
  "type": "module",
  "version": "0.1.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build:dev": "DEV_BUILD=true npm run build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "typecheck": "tsc --skipLibCheck --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "pre-push": "npm run typecheck",
    "pre-commit": "lint-staged",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@octokit/rest": "^22.0.1",
    "@react-three/fiber": "^9.8.2",
    "astro": "^7.4.7",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-intersection-observer": "^11.0.1",
    "three": "^0.187.0",
    "ua-parser-js": "^2.0.10",
    "x-is-type": "^1.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,astro}": "eslint",
    "*.{ts,tsx,js,mjs,cjs,css,md,astro,json}": "prettier --write"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
